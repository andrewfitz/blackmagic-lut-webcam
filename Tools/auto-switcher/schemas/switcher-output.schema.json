{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ultracam-auto-switcher/switcher-output",
  "title": "Auto switcher realtime output",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["cut", "status", "llmAdvisory", "decisionExpired", "error"] },
    "instruction": { "type": "object" },
    "time": { "type": "number" },
    "state": { "type": "string" },
    "current_camera_id": { "type": "string" },
    "hard_deadline": { "type": "number" },
    "pending_decision_id": { "type": ["string", "null"], "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "decision_id": { "type": "string", "format": "uuid" },
    "available_at": { "type": "number" },
    "target_camera_id": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string" },
    "hold": { "type": "boolean" },
    "error": { "type": ["string", "null"] },
    "message": { "type": "string" }
  },
  "additionalProperties": true
}
